# ── Database ────────────────────────────────────────────────────────────────
# Local dev (SQLite — default, zero install):
DATABASE_URL="file:./prisma/dimasa.db"

# Production (Neon/Supabase Postgres — used with schema.production.prisma):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/dimasa?sslmode=require"

# ── Auth ────────────────────────────────────────────────────────────────────
# MUST be a long random string in production (server refuses to start otherwise).
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CHANGE-THIS-TO-A-LONG-RANDOM-STRING-BEFORE-GOING-LIVE"

# ── Server ──────────────────────────────────────────────────────────────────
PORT=5000
# "production" disables: dev OTP backdoor (000000), console OTP logging, test-user seeding
NODE_ENV=development

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slashes):
CLIENT_URL="http://localhost:5173"
# Production example:
# CLIENT_URL="https://dimasa.vercel.app,https://www.dimasa.app"

# ── SMS / OTP (production only) ─────────────────────────────────────────────
# Until an SMS provider is wired, production OTPs go nowhere — users cannot log
# in without one. Wire MSG91 or Twilio in src/routes/auth.js before real launch.
# TWILIO_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_TOKEN="your_auth_token"
# TWILIO_PHONE="+1234567890"

# ── Google Sign-In (optional) ───────────────────────────────────────────────
# OAuth Client ID from Google Cloud Console (see GOOGLE_SETUP.md).
# When unset, /api/auth/google returns 503 and the frontend hides the button.
# GOOGLE_CLIENT_ID=1234567890-abcxyz.apps.googleusercontent.com

# ── Private admin login (pre-SMS access) ────────────────────────────────────
# Comma-separated admin phone numbers + a 6-digit master code, so admins can
# log in without SMS. Remove once a real SMS provider is wired.
# ADMIN_PHONES=9999999999
# ADMIN_OTP=509418

# ── Optional flags ──────────────────────────────────────────────────────────
# Allow the mock membership-upgrade endpoint on a production deploy (staging only!):
# ALLOW_MOCK_UPGRADE=true
