# ── Production only — leave unset in local dev (Vite proxy handles it) ──────
# Backend origin, no trailing slash:
# VITE_API_URL=https://dimasa-api.onrender.com

# Public URL of the app itself (used in invite/share messages):
# VITE_APP_URL=https://dimasa.vercel.app

# Google Sign-In client ID (from Google Cloud Console). When unset, the
# "Continue with Google" button is hidden. See GOOGLE_SETUP.md.
# VITE_GOOGLE_CLIENT_ID=1234567890-abcxyz.apps.googleusercontent.com
